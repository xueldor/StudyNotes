duration_ms: 60000

buffers: {
    size_kb: 32768
    fill_policy: DISCARD
}

buffers: {
    size_kb: 1280
    fill_policy: DISCARD
}

data_sources: {
    config {
        name: "linux.ftrace"
        ftrace_config {
            ftrace_events: "sched/sched_switch"
            ftrace_events: "irq/workqueue_execute_start"
			ftrace_events: "irq/workqueue_execute_end"
			ftrace_events: "irq/workqueue_activate_work"
			ftrace_events: "irq/irq_handler_entry"
			ftrace_events: "irq/irq_handler_exit"
			ftrace_events: "atc_disp/disp_virt_set_layers_configs"
			ftrace_events: "atc_disp/disp_virt_send_vblank"
            ftrace_events: "power/suspend_resume"
            ftrace_events: "sched/sched_process_exit"
            ftrace_events: "sched/sched_process_free"
            ftrace_events: "task/task_newtask"
            ftrace_events: "task/task_rename"
            ftrace_events: "ftrace/print"
			ftrace_events: "vmscan/mm_vmscan_kswapd_sleep"
			ftrace_events: "vmscan/mm_vmscan_kswapd_wake"
			ftrace_events: "vmscan/mm_vmscan_wakeup_kswapd"
			ftrace_events: "vmscan/mm_vmscan_direct_reclaim_begin"
			ftrace_events: "vmscan/mm_vmscan_memcg_reclaim_begin"
			ftrace_events: "vmscan/mm_vmscan_memcg_softlimit_reclaim_begin"
			ftrace_events: "vmscan/mm_vmscan_direct_reclaim_end"
			ftrace_events: "vmscan/mm_vmscan_memcg_reclaim_end"
			ftrace_events: "vmscan/mm_vmscan_memcg_softlimit_reclaim_end"
			ftrace_events: "vmscan/mm_shrink_slab_start"
			ftrace_events: "vmscan/mm_shrink_slab_end"
			ftrace_events: "vmscan/mm_vmscan_lru_isolate"
			ftrace_events: "vmscan/mm_vmscan_writepage"
			ftrace_events: "vmscan/mm_vmscan_lru_shrink_inactive"
			ftrace_events: "vmscan/mm_vmscan_lru_shrink_active"
			ftrace_events: "vmscan/mm_vmscan_inactive_list_is_low"
			ftrace_events: "vmscan/mm_vmscan_node_reclaim_begin"
			ftrace_events: "vmscan/mm_vmscan_node_reclaim_end"
            atrace_categories: "gfx"
            atrace_categories: "view"
            atrace_categories: "webview"
            atrace_categories: "camera"
            atrace_categories: "dalvik"
            atrace_categories: "power"
			atrace_categories: "input"
			atrace_categories: "audio"
        }
    }
}
data_sources: {
    config {
        name: "linux.process_stats"
        target_buffer: 1
        process_stats_config {
            scan_all_processes_on_start: true
        }
    }
}